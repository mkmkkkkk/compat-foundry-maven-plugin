{
  "type": "object",
  "required": [
    "schema_version",
    "catalog_version",
    "scope",
    "drifts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "drifts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "component",
          "old_behavior",
          "new_behavior",
          "severity",
          "business_impact",
          "versions",
          "detection",
          "fix",
          "sources",
          "verification"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "old_behavior": {
            "type": "string",
            "minLength": 1
          },
          "new_behavior": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "business_impact": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "object",
            "required": [
              "from_min",
              "from_max_exclusive",
              "to_min",
              "to_max_exclusive"
            ],
            "additionalProperties": false,
            "properties": {
              "from_min": {
                "type": "string",
                "minLength": 1
              },
              "from_max_exclusive": {
                "type": "string",
                "minLength": 1
              },
              "to_min": {
                "type": "string",
                "minLength": 1
              },
              "to_max_exclusive": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "detection": {
            "type": "object",
            "required": [
              "summary",
              "when",
              "mitigated_by",
              "confidence",
              "limitations"
            ],
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "$ref": "#/$defs/rule"
              },
              "mitigated_by": {
                "$ref": "#/$defs/rule"
              },
              "confidence": {
                "const": "potential"
              },
              "limitations": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "fix": {
            "type": "object",
            "required": [
              "language",
              "code",
              "application",
              "caveat",
              "verified_target"
            ],
            "additionalProperties": false,
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "application": {
                "type": "string",
                "minLength": 1
              },
              "caveat": {
                "type": "string",
                "minLength": 1
              },
              "verified_target": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url",
                "level",
                "publisher",
                "section"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "level": {
                  "const": "L3"
                },
                "publisher": {
                  "enum": [
                    "Spring",
                    "Hibernate"
                  ]
                },
                "section": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "verification": {
            "type": "object",
            "required": [
              "official_review",
              "runtime"
            ],
            "additionalProperties": false,
            "properties": {
              "official_review": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "runtime": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/rule"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "dependency"
          ],
          "additionalProperties": false,
          "properties": {
            "dependency": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source_regex"
          ],
          "additionalProperties": false,
          "properties": {
            "source_regex": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "unpaired_route"
          ],
          "additionalProperties": false,
          "properties": {
            "unpaired_route": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "property"
          ],
          "additionalProperties": false,
          "properties": {
            "property": {
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "file_regex"
          ],
          "additionalProperties": false,
          "properties": {
            "file_regex": {
              "type": "object",
              "required": [
                "glob",
                "pattern"
              ],
              "additionalProperties": false,
              "properties": {
                "glob": {
                  "type": "string",
                  "minLength": 1
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    }
  }
}
